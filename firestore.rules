rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /todos/{todoId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
      function likesBefore() {
        return resource.data.get('likes', []).toSet();
      }
      function likesAfter() {
        return request.resource.data.get('likes', []).toSet();
      }
      // True when the only change is the caller adding or removing their
      // own uid in `likes` (nobody can like on someone else's behalf).
      function onlyTogglesOwnLike() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && likesAfter().difference(likesBefore())
            .union(likesBefore().difference(likesAfter()))
            .hasOnly([request.auth.uid]);
      }

      // Owner can change anything; any signed-in user may reorder the
      // shared board by changing only the `order` field, or toggle their
      // own like.
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['order'])
          || onlyTogglesOwnLike());

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.uid;
      }
    }
  }
}
